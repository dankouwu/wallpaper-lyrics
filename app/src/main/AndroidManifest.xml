<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BIND_WALLPAPER" />

    <queries>
        <package android:name="com.spotify.music" />
        <package android:name="com.spotify.lite" />
        <package android:name="com.aspiro.tidal" />
        <package android:name="org.kde.kdeconnect_tp" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_background"
        android:label="Wallpaper Lyrics"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">

        <service
            android:name=".LyricsWallpaperService"
            android:exported="true"
            android:label="Lyrics Wallpaper"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <service
            android:name=".NotificationService"
            android:exported="true"
            android:label="Media Access"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BackgroundSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".EnhancedLyricsActivity"
            android:exported="false" />

    </application>

</manifest>
